{
  "manifest_version": 3,
  "name": "BeRaw — Behance Raw Image Grabber",
  "version": "0.1.8",
  "description": "Scan any Behance project and download raw, full-size images — single or batched ZIP. Behance 原图批量下载工具。",
  "permissions": [
    "activeTab",
    "downloads",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BeRaw — Behance Raw Image Grabber",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.behance.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
